# Practical: K-Means and Hierarchical Clustering

# 1. Import libraries
import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans, AgglomerativeClustering
from scipy.cluster.hierarchy import dendrogram, linkage

# 2. Load dataset
df = pd.read_csv("sales_data_sample.csv", encoding="latin1")

print("Dataset loaded successfully!")
print("Dataset Shape:", df.shape)
print(df.head())

# 3. Explore dataset
print("\nDataset Information:")
df.info()

print("\nMissing Values:")
print(df.isnull().sum())

print("\nDuplicate Rows:", df.duplicated().sum())

# 4. Select numerical features
data = df[['QUANTITYORDERED', 'PRICEEACH', 'SALES', 'MSRP']].copy()

# Handle missing values
data = data.fillna(data.median())

print("\nSelected Features:")
print(data.head())

# 5. Feature Scaling
scaler = StandardScaler()
scaled_data = scaler.fit_transform(data)

scaled_df = pd.DataFrame(
    scaled_data,
    columns=data.columns
)

print("\nFeature Scaling Completed!")

# 6. Elbow Method
wcss = []

for i in range(1, 11):
    kmeans = KMeans(
        n_clusters=i,
        init='k-means++',
        random_state=42,
        n_init=10
    )
    kmeans.fit(scaled_df)
    wcss.append(kmeans.inertia_)

plt.figure(figsize=(8, 5))
plt.plot(range(1, 11), wcss, marker='o')
plt.title('Elbow Method')
plt.xlabel('Number of Clusters (K)')
plt.ylabel('WCSS')
plt.xticks(range(1, 11))
plt.grid(True)
plt.show()

# 7. Apply K-Means Clustering
# Change 3 if your Elbow graph indicates another K
optimal_k = 3

kmeans = KMeans(
    n_clusters=optimal_k,
    init='k-means++',
    random_state=42,
    n_init=10
)

data['KMeans_Cluster'] = kmeans.fit_predict(scaled_df)

print("\nK-Means Cluster Distribution:")
print(data['KMeans_Cluster'].value_counts().sort_index())

# 8. Visualize K-Means
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=data,
    x='QUANTITYORDERED',
    y='SALES',
    hue='KMeans_Cluster',
    palette='viridis'
)
plt.title('K-Means Clustering')
plt.show()

# 9. Hierarchical Clustering - Dendrogram
linked = linkage(scaled_df, method='ward')

plt.figure(figsize=(12, 6))
dendrogram(
    linked,
    truncate_mode='lastp',
    p=20,
    show_leaf_counts=True
)
plt.title('Hierarchical Clustering Dendrogram')
plt.xlabel('Data Points / Clusters')
plt.ylabel('Euclidean Distance')
plt.show()

# 10. Apply Hierarchical Clustering
hc = AgglomerativeClustering(
    n_clusters=optimal_k,
    metric='euclidean',
    linkage='ward'
)

data['Hierarchical_Cluster'] = hc.fit_predict(scaled_df)

print("\nHierarchical Cluster Distribution:")
print(data['Hierarchical_Cluster'].value_counts().sort_index())

# 11. Visualize Hierarchical Clustering
plt.figure(figsize=(8, 5))
sns.scatterplot(
    data=data,
    x='QUANTITYORDERED',
    y='SALES',
    hue='Hierarchical_Cluster',
    palette='viridis'
)
plt.title('Hierarchical Clustering')
plt.show()

# 12. Compare both algorithms
print("\nFinal Cluster Comparison")
print("\nK-Means:")
print(data['KMeans_Cluster'].value_counts().sort_index())

print("\nHierarchical:")
print(data['Hierarchical_Cluster'].value_counts().sort_index())

print("\nPractical Executed Successfully!")
