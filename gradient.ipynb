# Practical: Implementation of Gradient Descent Algorithm
# Function: y = (x + 3)^2
# Starting point: x = 2

import numpy as np
import matplotlib.pyplot as plt

# Step 1: Define the function
def f(x):
    return (x + 3)**2

# Step 2: Define the derivative
def df(x):
    return 2 * (x + 3)

# Step 3: Initialize parameters
x = 2
learning_rate = 0.1
iterations = 20

x_values = []
y_values = []

print("Initial x:", x)
print("Initial y:", f(x))
print("\nGradient Descent Iterations:")

# Step 4: Apply Gradient Descent
for i in range(iterations):
    x_values.append(x)
    y_values.append(f(x))

    gradient = df(x)
    x = x - learning_rate * gradient

    print("Iteration:", i + 1, "| x:", round(x, 6),
          "| y:", round(f(x), 6))

# Step 5: Display the minimum
print("\nFinal Results")
print("Minimum x:", round(x, 6))
print("Minimum y:", round(f(x), 6))

# Step 6: Plot the function and descent steps
x_plot = np.linspace(-6, 3, 100)

plt.figure(figsize=(8, 5))
plt.plot(x_plot, f(x_plot), label='y = (x + 3)^2')
plt.scatter(x_values, y_values, color='red',
            label='Gradient Descent Steps')
plt.scatter(-3, 0, color='green', s=100,
            label='Actual Minimum')

plt.xlabel('x')
plt.ylabel('y')
plt.title('Gradient Descent Optimization')
plt.legend()
plt.grid(True)
plt.show()
